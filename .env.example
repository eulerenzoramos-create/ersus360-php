# ─────────────────────────────────────────────────────────────
# ERSUS360 — Variáveis de Ambiente (Railway)
# Configure cada variável no painel do Railway.
# NUNCA versione o .env com valores reais.
# ─────────────────────────────────────────────────────────────

APP_NAME="ERSUS 360"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ersus360.seudominio.com.br
APP_KEY=                    # php -r "echo base64_encode(random_bytes(32));"
APP_TIMEZONE=America/Manaus

# ── Banco de Dados ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ersus360
DB_USER=ersus360_user
DB_PASS=                    # senha forte aqui
DB_CHARSET=utf8mb4

# ── Segurança JWT ─────────────────────────────────────────────
JWT_SECRET=                 # openssl rand -base64 64
JWT_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# ── Município Padrão ─────────────────────────────────────────
MUNICIPIO_IBGE=1300144
MUNICIPIO_NOME=Apuí
MUNICIPIO_UF=AM

# ── Conta Admin Bootstrap ────────────────────────────────────
# Só para acesso inicial antes de criar usuários no BD
ADMIN_EMAIL=eulerenzoramos@gmail.com
ADMIN_SENHA=                # trocar imediatamente após primeiro login

# ── e-SUS PEC ─────────────────────────────────────────────────
ESUS_URL=https://esus.apui.am.gov.br
ESUS_USUARIO=               # login do e-SUS PEC
ESUS_SENHA=                 # senha do e-SUS PEC

# ── FNS ───────────────────────────────────────────────────────
FNS_BASE_URL=https://consultafns.saude.gov.br
FNS_API_BASE=https://apifns.saude.gov.br
FNS_API_CPF=                # CPF do gestor (sem pontos/traços)
FNS_API_SENHA=              # senha do gestor FNS

# ── eGestor APS ───────────────────────────────────────────────
EGESTOR_API_BASE=https://egestorab.saude.gov.br/api
EGESTOR_TOKEN=              # token eGestor APS

# ── SIAPS ─────────────────────────────────────────────────────
SIAPS_API_BASE=https://siaps.saude.gov.br
SIAPS_CPF=                  # CPF para autenticação SIAPS
SIAPS_SENHA=                # senha SIAPS
SIAPS_REFRESH_TOKEN=        # refresh token SIAPS

# ── CNES ──────────────────────────────────────────────────────
CNES_API=https://cnes.datasus.gov.br/services

# ── Email (Resend — recomendado) ──────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=             # re_... — nunca usar SMTP (Railway bloqueia porta 587)
EMAIL_FROM=noreply@seudominio.com.br
EMAIL_FROM_NAME="ERSUS 360 — SMS Apuí"

# ── IA (Anthropic Claude) ─────────────────────────────────────
ANTHROPIC_API_KEY=          # sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ── Logs ──────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_PATH=storage/logs/ersus360.log

# ── Upload de Arquivos ────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=pdf,xlsx,xls,csv,jpg,jpeg,png
UPLOAD_PATH=storage/uploads

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=https://ersus360.seudominio.com.br
