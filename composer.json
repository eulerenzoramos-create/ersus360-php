{
    "name": "ersus360/ersus360-php",
    "description": "ERSUS 360 — Sistema de Gestão em Saúde — SMS Apuí/AM",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.9",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.7",
        "phpmailer/phpmailer": "^6.9",
        "league/csv": "^9.15",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^3.4",
        "respect/validation": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "Ersus360\\": "app/",
            "Ersus360\\Core\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php artisan migrate",
        "seed": "php artisan seed",
        "test": "phpunit --colors=always",
        "cs": "phpcs --standard=PSR12 app/ core/",
        "analyse": "phpstan analyse app/ core/ --level=6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable"
}
